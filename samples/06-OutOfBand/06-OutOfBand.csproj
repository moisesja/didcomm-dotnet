<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DidComm.Samples.OutOfBand</RootNamespace>
    <AssemblyName>DidComm.Samples.OutOfBand</AssemblyName>
    <IsPackable>false</IsPackable>
    <Description>didcomm-dotnet Out-of-Band 2.0 — build an invitation, encode it to the ?_oob= URL behind a QR code (padding-free base64url), decode it on a second device, serve the short-URL form over HTTP (MapDidCommOobEndpoint + IOobInvitationStore), and correlate the encrypted response back to the invitation via pthid (PRD §14.3 sample 06, task V, FR-OOB-*).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetDid.Core" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DidComm.Core\DidComm.Core.csproj" />
    <ProjectReference Include="..\..\src\DidComm.Extensions.DependencyInjection\DidComm.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\DidComm.AspNetCore\DidComm.AspNetCore.csproj" />
    <ProjectReference Include="..\..\tests\DidComm.TestSupport\DidComm.TestSupport.csproj" />
    <ProjectReference Include="..\_shared\_shared.csproj" />
  </ItemGroup>

</Project>
