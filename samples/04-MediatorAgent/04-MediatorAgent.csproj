<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DidComm.Samples.MediatorAgent</RootNamespace>
    <AssemblyName>DidComm.Samples.MediatorAgent</AssemblyName>
    <IsPackable>false</IsPackable>
    <Description>didcomm-dotnet mediated routing over HTTP — an ASP.NET Core mediator (MapDidCommEndpoint receive + ForwardProcessor Routing 2.0 relay) plus a console flow routing Alice → Mediator → Bob with did:peer identities carrying routingKeys, including the outbound-endpoint SSRF guard and its explicit loopback opt-in (PRD §14.3 sample 04, tasks O/P/Q).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetDid.Core" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DidComm.Core\DidComm.Core.csproj" />
    <ProjectReference Include="..\..\src\DidComm.Extensions.DependencyInjection\DidComm.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\DidComm.Transports.Http\DidComm.Transports.Http.csproj" />
    <ProjectReference Include="..\..\src\DidComm.AspNetCore\DidComm.AspNetCore.csproj" />
    <ProjectReference Include="..\..\tests\DidComm.TestSupport\DidComm.TestSupport.csproj" />
    <ProjectReference Include="..\_shared\_shared.csproj" />
  </ItemGroup>

</Project>
