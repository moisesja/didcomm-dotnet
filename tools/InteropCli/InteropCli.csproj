<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>InteropCli</RootNamespace>
    <AssemblyName>InteropCli</AssemblyName>
    <IsPackable>false</IsPackable>
    <Description>Live cross-implementation interop CLI (FR-IX-04/05): mints did:peer:2 identities via net-did, and packs/unpacks DIDComm v2 envelopes with the real DidCommClient + NetDidKeyService so shell harnesses (tools/interop-live) can round-trip messages against the SICPA reference implementations. It also runs a didcomm-dotnet mediator in process (mediator-pickup) so a counterpart-built forward travels through the real endpoint, pipeline and pickup queue. Usage: dotnet run --project tools/InteropCli -- mint|pack|unpack|unwrap-forward|mediator-pickup [options]</Description>
  </PropertyGroup>

  <!-- mediator-pickup hosts a Kestrel mediator: the ASP.NET Core shared framework provides the
       Microsoft.Extensions.* assemblies, so none is referenced as a package here (L-012). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetDid.Core" />
    <PackageReference Include="NetDid.Method.Key" />
    <PackageReference Include="NetDid.Method.Peer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DidComm.Core\DidComm.Core.csproj" />
    <ProjectReference Include="..\..\src\DidComm.Extensions.DependencyInjection\DidComm.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\DidComm.Mediator.AspNetCore\DidComm.Mediator.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\DidComm.Transports.Http\DidComm.Transports.Http.csproj" />
    <ProjectReference Include="..\..\tests\DidComm.TestSupport\DidComm.TestSupport.csproj" />
  </ItemGroup>

</Project>
