# Images of the mediator leg (run-mediator-leg.sh), each pinned by tag AND digest.
#
# The leg pulls each ref, then requires `docker image inspect` to list the pinned digest in
# RepoDigests, so a tag that moves upstream can never change what runs. The digest is the
# multi-arch index (manifest list); Docker picks the platform manifest of the host from it.
# Format: KEY=ref, one per line; the leg parses these lines, it never sources this file.
#
# How each digest was verified (2026-11-19), and how to re-verify before a pin bump:
#   docker buildx imagetools inspect <repo>:<tag>     → "Digest:" must equal the pin
#   docker pull <ref> && docker image inspect --format '{{json .RepoDigests}}' <ref>
# Bump procedure: tools/interop-live/README.md, "Mediator leg", "Pins and provenance".

# Hyperledger Identus mediator v1.2.1 (the owner's choice for #98: that release only).
# Index digest from `docker buildx imagetools inspect`; platform manifests linux/amd64
# sha256:b046dc37d8612b6837d8b7e73e11ee623f3001c5e7df1b42a8922e4395c25ddc and linux/arm64
# sha256:ef2f31febd325465524a8e2298a084873923626ca45ef74a17874eb3fe5da5da (no emulation on Apple
# Silicon; CI x86_64 is the authority). Image labels: org.opencontainers.image.version=1.2.1,
# org.opencontainers.image.revision=b85da0bfc24a4aaba57223c98e7b15fbaf866948 (the v1.2.1 tag
# commit). Bundles scala-did app.fmgp.did*_3-0.1.0-M48 and zio-http_3-3.11.1 (/opt/docker/lib).
IDENTUS_IMAGE=docker.io/hyperledgeridentus/identus-mediator:1.2.1@sha256:0f0378d95c633fb084b9b85a67dd5e48f899ecce6f9b3fbba226f14bfdbf412b

# MongoDB for each Identus instance (Identus's compose file uses mongo:6.0; the floating 6.0 tag
# resolves to a different index, so the exact 6.0.28-jammy tag is pinned). Platform manifests
# linux/amd64 sha256:268eb517abcb8a1bb4cf5f290ec2ac37185e78bfb62e7111576bbb3d8b092456 and
# linux/arm64/v8 sha256:3ed30e2875f51747c16be3807301f5595ea44a29ab339be3668c3eecd115cd89.
MONGO_IMAGE=docker.io/library/mongo:6.0.28-jammy@sha256:a90cef0143bed76540c2b7e6f299a02165e59b07e459b2fd7fef031c5accf5fd

# Squid forward proxy (Canonical's ubuntu/squid; runs Squid 6.13 although the tag says 6.6) for
# the TrustedProxy and process-proxy cells. Re-verified 2026-11-19 with
# `docker buildx imagetools inspect docker.io/ubuntu/squid:6.6-24.04_beta` → index Digest
# sha256:6a097f68…e029 (as below); platform manifests linux/amd64
# sha256:8fafd41d6ddceb295d26eea9938321d825ac5351c7e46cf6a8aa5d093b8ed1ce and linux/arm64/v8
# sha256:eecf35336788c1ab143566bca99ac58f213e9f17906a9a684346d7b323b6696c (plus ppc64le, s390x);
# `docker pull` by this ref, then RepoDigests = ["ubuntu/squid@sha256:6a097f68…e029"].
SQUID_IMAGE=docker.io/ubuntu/squid:6.6-24.04_beta@sha256:6a097f68bae708cedbabd6188d68c7e2e7a38cedd05a176e1cc0ba29e3bbe029
