<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DidComm.InteropTests</RootNamespace>
    <AssemblyName>DidComm.InteropTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Mono.Cecil" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DidComm.Core\DidComm.Core.csproj" />
    <ProjectReference Include="..\..\src\DidComm.Transports.Http\DidComm.Transports.Http.csproj" />
    <ProjectReference Include="..\..\src\DidComm.Transports.WebSocket\DidComm.Transports.WebSocket.csproj" />
    <ProjectReference Include="..\..\src\DidComm.AspNetCore\DidComm.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\DidComm.Adapters.NetDid\DidComm.Adapters.NetDid.csproj" />
    <ProjectReference Include="..\..\samples\01-Quickstart\01-Quickstart.csproj" />
    <ProjectReference Include="..\..\samples\02-Cookbook\02-Cookbook.csproj" />
    <ProjectReference Include="..\..\samples\03-EnvelopesAndMessages\03-EnvelopesAndMessages.csproj" />
    <ProjectReference Include="..\..\samples\04-MediatorAgent\04-MediatorAgent.csproj" />
    <ProjectReference Include="..\..\samples\05-WebSocketChat\05-WebSocketChat.csproj" />
    <ProjectReference Include="..\..\samples\06-OutOfBand\06-OutOfBand.csproj" />
    <ProjectReference Include="..\..\samples\07-ProblemsAndProtocols\07-ProblemsAndProtocols.csproj" />
    <ProjectReference Include="..\..\samples\08-Extensibility\08-Extensibility.csproj" />
    <ProjectReference Include="..\..\samples\09-NetDidIntegration\09-NetDidIntegration.csproj" />
    <ProjectReference Include="..\..\samples\10-ProfilesAndI18n\10-ProfilesAndI18n.csproj" />
    <ProjectReference Include="..\DidComm.TestSupport\DidComm.TestSupport.csproj" />
  </ItemGroup>

  <!--
    ./fixtures is the didcomm-dotnet-fixtures git submodule (PRD §13.3):
    https://github.com/moisesja/didcomm-dotnet-fixtures. Initialize submodules
    after cloning (git submodule update with the init flag); the data-driven
    runner (FR-IX-02) enumerates fixtures/manifest/**/*.json.
  -->
  <ItemGroup>
    <None Include="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- FR-DX-01: the justified exceptions to the two public-API gates — coverage-allowlist.json for
       the static reference gate (PublicApiCoverageTests), execution-allowlist.json for the runtime
       execution gate (PublicApiExecutionTests). Read at run time. -->
  <ItemGroup>
    <None Include="DxCoverage\coverage-allowlist.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="DxCoverage\execution-allowlist.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
